# Copy to .env (gitignored) and fill in. Never commit .env.
# Shared secret — must equal the Worker secret HERMES_PANEL_SECRET.
PANEL_SECRET=

# Hermes dashboard (port 9119) session token. The proxy sends it as
# `X-Hermes-Session-Token` on every /dash/* call. Without it the dashboard answers 401 and
# the panel cannot list bots, read/write SOUL or switch models.
# This is the value the dashboard was started with (HERMES_DASHBOARD_SESSION_TOKEN).
HERMES_DASHBOARD_SESSION_TOKEN=

# Gateway keys are read from the Hermes profile directories at request time (cached ~30 s):
# `default` uses %LOCALAPPDATA%\hermes\.env, every other bot profiles\<bot>\.env — each file's
# API_SERVER_KEY. So a profile created in the panel works without editing this file, and a
# rotated key needs no restart. A profile without a key is refused with 404.
# HERMES_KEY_<BOT> (uppercase, non-alphanumerics → underscores) is an optional override and
# wins over the profile file; leave them empty unless you need to pin a key here.
HERMES_KEY_CLOUDFLARE=
HERMES_KEY_MINECRAFT=
HERMES_KEY_DISCORD=
HERMES_KEY_HOMELAB=

# Optional: key for /gw/ routes without a profile prefix. Also the fallback for the
# `default` bot when %LOCALAPPDATA%\hermes\.env has no API_SERVER_KEY.
API_SERVER_KEY=

# Optional: Hermes data directory if it is not %LOCALAPPDATA%\hermes.
# HERMES_HOME=

# Listen port (loopback only).
PORT=8650
GATEWAY=http://127.0.0.1:8642
DASHBOARD=http://127.0.0.1:9119
