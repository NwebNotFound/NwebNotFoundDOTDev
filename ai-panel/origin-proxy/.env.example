# Copy to .env (gitignored) and fill in. Never commit .env.
# Shared secret — must equal the Worker secret HERMES_PANEL_SECRET.
PANEL_SECRET=
# Hermes gateway key (the gateway's API_SERVER_KEY).
API_SERVER_KEY=
# Listen port (loopback only).
PORT=8650
GATEWAY=http://127.0.0.1:8642
DASHBOARD=http://127.0.0.1:9119
