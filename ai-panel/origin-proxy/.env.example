# Copy to .env (gitignored) and fill in. Never commit .env.
# Shared secret — must equal the Worker secret HERMES_PANEL_SECRET.
PANEL_SECRET=

# Hermes dashboard (port 9119) session token. The proxy sends it as
# `X-Hermes-Session-Token` on every /dash/* call. Without it the dashboard answers 401 and
# the panel cannot list bots, read/write SOUL or switch models.
# This is the value the dashboard was started with (HERMES_DASHBOARD_SESSION_TOKEN).
HERMES_DASHBOARD_SESSION_TOKEN=

# One gateway key per bot profile. The proxy picks the key from the /p/<bot>/ prefix, so
# `cloudflare` reads HERMES_KEY_CLOUDFLARE and `my-bot` reads HERMES_KEY_MY_BOT
# (non-alphanumerics become underscores, upper-cased). A profile without a key is refused
# with 404. Each value is that profile's API_SERVER_KEY in its Hermes config.
HERMES_KEY_CLOUDFLARE=
HERMES_KEY_MINECRAFT=
HERMES_KEY_DISCORD=
HERMES_KEY_HOMELAB=

# Optional: key for gateway routes that carry no profile prefix (/gw/health, …).
API_SERVER_KEY=

# Listen port (loopback only).
PORT=8650
GATEWAY=http://127.0.0.1:8642
DASHBOARD=http://127.0.0.1:9119
